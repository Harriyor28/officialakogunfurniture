# Copy this file to .env and fill in real values before deploying.

# --- Database (SQLite file path) ---
# Local development: a file inside the project.
DATABASE_URL="file:./prisma/dev.db"
# Containers / hosts with a mounted volume: point at the volume instead, e.g.
#   DATABASE_URL="file:/data/akogun.db"

# --- Sessions ---
# Long random string (32+ chars). Generate with: openssl rand -hex 32
# Production will refuse to start without a real value.
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Public site URL (runtime; used in emails, sitemap, robots, canonical) ---
SITE_URL="http://localhost:3200"

# Build-time fallback for SITE_URL. NEXT_PUBLIC_* values are inlined into the
# bundle when the app is built, so prefer SITE_URL above for production.
NEXT_PUBLIC_SITE_URL=""

# --- Contact details (override what is stored in the admin settings) ---
BUSINESS_PHONE=""
BUSINESS_WHATSAPP_NUMBER=""
BUSINESS_EMAIL=""
# Legacy aliases (build-time); the runtime variables above take precedence.
NEXT_PUBLIC_BUSINESS_PHONE=""
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_BUSINESS_EMAIL=""

# --- Persistent state directory (containers only, defaults to /data) ---
# DATA_DIR="/data"

# --- Seed admin account (used by prisma/seed.mjs on first run) ---
ADMIN_EMAIL="admin@akogunfurniture.local"
# Leave empty to auto-generate a strong password (printed during seed).
ADMIN_PASSWORD=""

# --- Email (optional) ---
# When RESEND_API_KEY is empty emails are logged to NotificationLog as SKIPPED
# and never claimed as sent.
RESEND_API_KEY=""
EMAIL_FROM="Official Akogun Furniture <no-reply@yourdomain.com>"
