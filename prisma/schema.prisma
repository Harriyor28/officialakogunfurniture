// Official Akogun Furniture — database schema
// Provider: SQLite for local development (portable to PostgreSQL by switching the
// datasource provider and changing String status fields to native enums).
// NOTE (Prisma 7): the datasource `url` lives in prisma.config.ts, not here.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  // SUPER_ADMIN | ADMIN | PROJECT_MANAGER | STAFF | CUSTOMER
  role          String    @default("CUSTOMER")
  emailVerified DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions          Session[]
  passwordResets    PasswordReset[]
  assignedEnquiries Enquiry[]         @relation("EnquiryAssignee")
  ownedProjects     CustomerProject[] @relation("ProjectOwner")
  auditLogs         AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Public catalogue / portfolio content
// ---------------------------------------------------------------------------

model FurnitureCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  image       String?
  order       Int     @default(0)
  published   Boolean @default(true)

  projects        Project[]
  products        Product[]
  services        Service[]
  customerProjects CustomerProject[]
}

model Project {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  categoryId    String?
  summary       String?
  description   String?
  inspiration   String?
  materials     String?
  dimensions    String?
  location      String? // only store when the customer permits publication
  completedAt   DateTime?
  // COMPLETED | IN_PROGRESS | AVAILABLE_CUSTOM | ARCHIVED
  status        String    @default("IN_PROGRESS")
  published     Boolean   @default(false)
  featured      Boolean   @default(false)
  coverImage    String?
  seoTitle      String?
  seoDescription String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category FurnitureCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images   ProjectImage[]

  @@index([published, featured])
  @@index([categoryId])
  @@index([status])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  url       String
  alt       String  @default("")
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Service {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  image       String?
  icon        String?
  order       Int     @default(0)
  published   Boolean @default(true)

  category FurnitureCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
}

model Product {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  categoryId    String?
  summary       String?
  description   String?
  dimensions    String?
  materials     String?
  colours       String?
  // Prices are optional and stored in whole naira. Never invent prices.
  priceFrom     Int?
  priceTo       Int?
  currency      String  @default("NGN")
  // IN_STOCK | MADE_TO_ORDER | UNAVAILABLE | ASK
  availability  String  @default("ASK")
  leadTime      String?
  customisable  Boolean @default(true)
  featured      Boolean @default(false)
  published     Boolean @default(false)
  seoTitle      String?
  seoDescription String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category FurnitureCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images   ProductImage[]

  @@index([published, featured])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String  @default("")
  order     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Enquiries & quotations
// ---------------------------------------------------------------------------

model Enquiry {
  id                String    @id @default(cuid())
  reference         String    @unique
  name              String
  email             String
  phone             String
  preferredContact  String    @default("PHONE") // PHONE | EMAIL | WHATSAPP
  serviceCategory   String
  furnitureType     String?
  title             String?
  requirements      String
  dimensions        String?
  materials         String?
  quantity          Int?
  budgetRange       String?
  location          String?
  preferredDate     DateTime?
  comments          String?
  privacyAccepted   Boolean   @default(false)
  // NEW | UNDER_REVIEW | AWAITING_INFO | QUOTATION_PREPARED | QUOTATION_SENT |
  // APPROVED | DECLINED | CONVERTED | CLOSED
  status            String    @default("NEW")
  internalNotes     String?
  assignedToId      String?
  source            String    @default("WEBSITE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  assignedTo   User?               @relation("EnquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  attachments  EnquiryAttachment[]
  quotations   Quotation[]
  projects     CustomerProject[]

  @@index([status])
  @@index([createdAt])
  @@index([assignedToId])
}

model EnquiryAttachment {
  id        String   @id @default(cuid())
  enquiryId String
  url       String
  filename  String
  size      Int      @default(0)
  createdAt DateTime @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
}

model Quotation {
  id         String    @id @default(cuid())
  reference  String    @unique
  enquiryId  String
  // DRAFT | SENT | APPROVED | DECLINED | EXPIRED | CONVERTED
  status     String    @default("DRAFT")
  validUntil DateTime?
  subtotal   Int       @default(0)
  discount   Int       @default(0)
  delivery   Int       @default(0)
  notes      String?
  terms      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  enquiry Enquiry          @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  items   QuotationItem[]
  project CustomerProject?

  @@index([enquiryId])
  @@index([status])
}

model QuotationItem {
  id            String  @id @default(cuid())
  quotationId   String
  description   String
  quantity      Int     @default(1)
  unitPrice     Int     @default(0)
  order         Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

// ---------------------------------------------------------------------------
// Customer projects (tracking portal)
// ---------------------------------------------------------------------------

model CustomerProject {
  id               String    @id @default(cuid())
  reference        String    @unique
  title            String
  customerUserId   String
  categoryId       String?
  enquiryId        String?
  quotationId      String?   @unique
  // ENQUIRY_RECEIVED | CONSULTATION | MEASUREMENT_DESIGN | QUOTATION_PENDING |
  // AWAITING_APPROVAL | AWAITING_DEPOSIT | MATERIALS | PRODUCTION | FINISHING |
  // READY_DELIVERY | INSTALLATION | COMPLETED | AFTER_SALES
  status           String    @default("CONSULTATION")
  summary          String?
  specifications   String?
  startDate        DateTime?
  expectedEndDate  DateTime?
  progressPercent  Int       @default(0)
  nextMilestone    String?
  internalNotes    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer   User                @relation("ProjectOwner", fields: [customerUserId], references: [id], onDelete: Cascade)
  enquiry    Enquiry?            @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  quotation  Quotation?          @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  category   FurnitureCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  milestones CustomerMilestone[]
  updates    ProjectUpdate[]

  @@index([customerUserId])
  @@index([status])
}

model CustomerMilestone {
  id        String    @id @default(cuid())
  projectId String
  name      String
  dueDate   DateTime?
  // PENDING | IN_PROGRESS | DONE
  status    String    @default("PENDING")
  order     Int       @default(0)
  visible   Boolean   @default(true)

  project CustomerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectUpdate {
  id                String    @id @default(cuid())
  projectId         String
  title             String
  description       String
  stage             String?
  imageUrl          String?
  visibleToCustomer Boolean   @default(true)
  createdAt         DateTime  @default(now())

  project CustomerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Content & settings
// ---------------------------------------------------------------------------

model Testimonial {
  id          String   @id @default(cuid())
  authorName  String
  projectType String?
  content     String
  rating      Int?
  imageUrl    String?
  approved    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([approved, published])
}

model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String
  content        String
  coverImage     String?
  authorName     String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, publishedAt])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model NotificationLog {
  id          String   @id @default(cuid())
  channel     String // EMAIL | WHATSAPP | SYSTEM
  recipient   String
  subject     String
  body        String?
  // SENT | SKIPPED | FAILED
  status      String   @default("SKIPPED")
  error       String?
  relatedType String?
  relatedId   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
